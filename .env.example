# Firebase Client SDK (Vite — exposed to browser, VITE_ prefix required)
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_DATABASE_ID="(default)"

# Admin access control — email that gets admin dashboard access
VITE_ADMIN_EMAIL="admin@yourdomain.com"

# Firebase Admin SDK (server-side only — never expose to browser)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_DATABASE_ID="(default)"

# Server
APP_URL="http://localhost:3000"
PORT=3000

# Risk engine — email domain that receives a +5 trust score boost
TRUSTED_EMAIL_DOMAIN="yourdomain.com"

# Gemini AI (if used)
GEMINI_API_KEY="your-gemini-api-key"
